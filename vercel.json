{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "api/index.js"
    },
    {
      "src": "/robots.txt",
      "dest": "api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/styles/(.*)",
      "dest": "/web/styles/$1"
    },
    {
      "src": "/src/(.*)",
      "dest": "/web/src/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/web/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/web/sw.js"
    },
    {
      "src": "/(.*)",
      "dest": "/web/index.html"
    }
  ]
}
