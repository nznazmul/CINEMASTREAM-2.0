{
  "version": 2,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/index.js" },
    { "source": "/robots.txt", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/styles/(.*)", "destination": "/web/styles/$1" },
    { "source": "/src/(.*)", "destination": "/web/src/$1" },
    { "source": "/manifest.json", "destination": "/web/manifest.json" },
    { "source": "/sw.js", "destination": "/web/sw.js" },
    { "source": "/(.*)", "destination": "/web/index.html" }
  ]
}
